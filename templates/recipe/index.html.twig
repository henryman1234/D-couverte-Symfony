{%  extends "base.html.twig" %}

{% block title%}Toutes les recettes{%endblock %}

{%  block body %}

<h1>La page de toutes les Recettes</h1>

<p>
    <a class="btn btn-primary btn-sm" href="{{path('recipe.create')}}">Créer une recette</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        {% for recipe in recipes%}
            <tr>
                <td>
                    <a href="{{url('recipe.show', {id: recipe.id, slug: recipe.slug})}}">{{recipe.getTitle()}}</a>
                </td>

                <td>

                    <div class="d-flex gap-2">

                        <a class="btn-sm btn btn-primary" href="{{url('recipe.edit', {id: recipe.id})}}">Modifier</a>

                        <!-- Les formumlaires n'acceptent les requets en Delete -->
                        <form action="{{path('recipe.delete', {id: recipe.id})}}" method="post">

                            <input type="hidden" name="_method"  value="DELETE">
                            <button type="submit"  class="btn-sm  btn btn-danger">Supprimer</button>

                        </form>

                    </div>

                </td>


            </tr>
        {% endfor %}

    </tbody>
</table>




{% endblock %}