{% extends "base.html.twig" %}

{% block title "Toutes les recettes" %}


{% block body %}

<h2>Toutes les recettes disponibles</h2>

<ul>
    {% for recipe in recipes %}
        <li>
            <a href="{{url('recipe.show', {slug: recipe.slug,  id:recipe.id})}}">{{recipe.title}}</a>
        </li>
    {% endfor %}
</ul>

{% endblock %}